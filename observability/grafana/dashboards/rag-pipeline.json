{
  "title": "FutBot - RAG Pipeline",
  "uid": "futbot-rag-pipeline",
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "LLM Call Rate by Step / Status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (step, status) (rate(futbot_llm_calls_total[5m]))",
          "legendFormat": "{{step}} - {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "LLM Call p95 Latency by Step",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (step, le) (rate(futbot_llm_call_duration_seconds_bucket[5m])))",
          "legendFormat": "{{step}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Retrieval Latency (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(futbot_retrieval_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(futbot_retrieval_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "title": "Chunks Returned per Retrieval (median)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(futbot_retrieval_chunks_returned_bucket[15m])))",
          "legendFormat": "median chunks"
        }
      ]
    },
    {
      "id": 5,
      "title": "Ingestion Jobs by Outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (status) (rate(futbot_ingestion_jobs_total[15m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Ingestion Job Duration (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(futbot_ingestion_job_duration_seconds_bucket[15m])))",
          "legendFormat": "p95"
        }
      ]
    }
  ]
}
